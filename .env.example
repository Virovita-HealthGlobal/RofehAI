# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real secrets to this repo.

# Required for the agent endpoint (POST /api/agent/ask) to work at all.
# Without this, that one endpoint returns 503; everything else in
# RofehAI runs fine without it.
ANTHROPIC_API_KEY=

# Global daily cap on agent calls (real $ per call against your
# Anthropic account) -- protects against unbounded cost if the gate
# passcode is shared more widely than intended. Defaults to 100/day if
# unset. Once reached, /api/agent/ask returns 429 until the next day.
ROFEHAI_AGENT_DAILY_LIMIT=

# Optional -- see README for what each controls. Safe to leave blank
# for local dev; set real values before any real/public deployment.
ROFEHAI_GATE_CODE=
ROFEHAI_API_KEY=
ROFEHAI_DATABASE_URL=

# Required to create real user accounts (POST /api/auth/users). This is
# DELIBERATELY SEPARATE from ROFEHAI_API_KEY -- setting that one also
# requires every /api/* request to carry it, which would lock out the
# public dashboard. Use a different secret here.
ROFEHAI_ADMIN_KEY=

# Required for self-service signup (POST /api/auth/signup), password
# setup/reset emails, and the contact form to actually send. Uses plain
# SMTP through your existing mailbox (e.g. Hostinger) -- switched from
# Resend after their account-side permissions rejected every send
# attempt (confirmed via a raw API call bypassing this app's own code
# entirely) with no time to wait on their support. Without these set,
# signup/contact still work but return a clear error saying the
# notification failed -- nothing is silently lost.
ROFEHAI_SMTP_HOST=
ROFEHAI_SMTP_PORT=
ROFEHAI_SMTP_USERNAME=
ROFEHAI_SMTP_PASSWORD=
ROFEHAI_ADMIN_NOTIFY_EMAIL=
# The approve/reject links embedded in that email need a real, public
# base URL to point at (e.g. https://api.rofehai.com) -- without this,
# the links would point at an empty path.
ROFEHAI_PUBLIC_API_BASE=

# The password-setup link (sent to the REQUESTER, after approval, and
# also used for "forgot password") needs the real public URL of the
# FRONTEND app -- e.g. https://app.rofehai.com -- so the link opens
# set-password.html correctly, not the API.
ROFEHAI_PUBLIC_APP_BASE=
